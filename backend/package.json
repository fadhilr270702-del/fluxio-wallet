{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Fluxio admin backend API: admin auth (session-based) and Announcements CRUD + public read endpoint. SQLite for dev; see README for the Postgres migration path.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "create-admin": "node scripts/createAdmin.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@fluxio/constants": "workspace:*",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "multer": "2.2.0",
    "sanitize-html": "2.17.6",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "nodemon": "3.1.4",
    "vitest": "3.2.4"
  }
}
