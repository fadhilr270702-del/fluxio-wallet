# Copy this file to .env and fill in real values. Never commit .env.

# HTTP port the backend listens on.
PORT=4000

# development | production — controls the Secure flag on the session cookie
# (Secure requires HTTPS, so it's forced off in development).
NODE_ENV=development

# Where the SQLite database file lives. Relative paths resolve from backend/.
DATABASE_PATH=./data/fluxio-admin.db

# Origin the admin frontend is served from — used for the CORS allowlist.
# In dev, the admin app proxies through Vite so this mostly matters for
# non-proxied/production deployments.
ADMIN_ORIGIN=http://localhost:4174

# Session cookie name and lifetime.
SESSION_COOKIE_NAME=fluxio_admin_session
SESSION_TTL_DAYS=7

# Set to "true" to force the cookie's Secure flag even outside production
# (e.g. testing behind an HTTPS tunnel). Normally leave unset in dev.
COOKIE_SECURE=false

# bcrypt cost factor for password hashing. 12 is a reasonable default;
# raise it as hardware gets faster, lower it only for throwaway local testing.
BCRYPT_COST=12

# Prompt 0191 — the Telegram kill switch: set to 1 (or true) to force EVERY
# bot token to null regardless of what the token variables below contain, so
# no poller/worker/welcome/admin send can ever run in that process — use it
# for LOCAL VERIFICATION backends (spawn via a Node launcher, then QUOTE the
# "[telegram] DISABLED by TELEGRAM_DISABLED=1" startup line as proof — see
# CLAUDE.md deploy lesson 8 and the 0181/0188 incidents it exists because
# of). NEVER set this on the production VM.
TELEGRAM_DISABLED=

# Prompt 0138 — dual-bot foundation. Two independent bot tokens from
# @BotFather (https://t.me/BotFather), one per bot identity ('test'/
# 'official', see backend/src/telegram/botIds.js). Leave either empty for
# local dev without that bot — its own subscriber poller/worker skip
# starting (logged once, not fatal), while the other bot keeps working
# normally. TELEGRAM_BOT_TOKEN_OFFICIAL has no legacy fallback (there was
# never an "official" bot before this prompt).
TELEGRAM_BOT_TOKEN_TEST=
TELEGRAM_BOT_TOKEN_OFFICIAL=

# Deprecated — kept only so a deployment that hasn't migrated its .env yet
# doesn't break. If this is set and TELEGRAM_BOT_TOKEN_TEST is NOT, its
# value is used as the 'test' bot's token (with a one-time startup warning
# logged). Never used for the 'official' bot. New deployments should use
# TELEGRAM_BOT_TOKEN_TEST above instead and leave this blank.
TELEGRAM_BOT_TOKEN=

# A private Telegram channel or group (that bot added as admin) used only
# to upload an admin-selected broadcast image once and get back a reusable
# file_id — never seen by real subscribers/channels. To get its chat ID:
# create the private channel/group, add the bot as admin, send any message
# in it, then check the bot's getUpdates response (or forward that message
# to @getidsbot) for the numeric chat id (looks like -100xxxxxxxxxx for a
# channel). Leave empty to disable image upload for that bot — the
# composer's file picker returns a clear "not configured" error instead of
# failing oddly. Prompt 0138 note: the broadcast composer's own image/video
# upload flow is deliberately still hardcoded to the 'test' bot in this
# Stage-A prompt (see telegramBroadcastController.js's own comment) — this
# per-bot plumbing exists for Stage C's planned media rework, not used yet.
TELEGRAM_STORAGE_CHAT_ID_TEST=
TELEGRAM_STORAGE_CHAT_ID_OFFICIAL=

# Deprecated, same fallback shape as TELEGRAM_BOT_TOKEN above — used as the
# 'test' bot's storage chat only if TELEGRAM_STORAGE_CHAT_ID_TEST is unset.
TELEGRAM_STORAGE_CHAT_ID=

# How long each getUpdates long-poll call waits for new updates, in seconds.
TELEGRAM_POLL_TIMEOUT_SECONDS=25

# Broadcast worker throttling: up to this many messages sent per tick, one
# tick per TELEGRAM_WORKER_TICK_MS. 20 msgs / 1000ms = ~20/sec, comfortably
# under Telegram's ~30/sec cap with headroom for the poller's own traffic.
TELEGRAM_WORKER_BATCH_SIZE=20
TELEGRAM_WORKER_TICK_MS=1000

# Recurring-broadcast send cadence (prompt 0134), in milliseconds. Leave
# unset in any real deployment — the default is a real 1 hour (3600000ms).
# Only set this to something short (e.g. 60000 for 1 minute) in a local dev
# session to verify the worker's own due-check without waiting an hour
# between rounds.
RECURRING_INTERVAL_MS=
